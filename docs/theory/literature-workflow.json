{
  "name": "riseloop-literature-workflow",
  "version": "1.0.0",
  "run_id": "2026-11-07",
  "scope": "offline-data-preparation",
  "spec": "docs/theory/agent-workflow.md",
  "purpose": "产出可核验的权威文献台账，作为 RiseLoop 久坐行为干预系统的理论依据",
  "integration":
  {
    "runtime_integration": false,
    "forbidden_targets": ["services/agent-orchestrator", "apps/cloud-api", "services/mcp-servers"],
    "mcp_tool_budget": "固定 3 个，本工作流不得新增或复用运行时工具",
    "note": "纯离线资料工作流；不进入产品业务链路，不改动端侧与云端代码"
  },
  "naming":
  {
    "canonical_product_name": "RiseLoop",
    "legacy_alias_in_spec": "SitLoop",
    "rule": "产出文件中统一写作 RiseLoop；不修改 agent-workflow.md 原文"
  },
  "artifacts":
  {
    "evidence": "data/knowledge/evidence.json",
    "schema": "data/knowledge/evidence.schema.json",
    "qc_report": "data/knowledge/qc-report.md",
    "evidence_map": "docs/theory/evidence-map.md",
    "inbox": "data/knowledge/files/（原文 PDF，不入 Git，仅本地留档）"
  },
  "sources": [
    {
      "id": "pubmed",
      "label": "PubMed E-utilities",
      "access": "api",
      "mode": "anonymous",
      "endpoint": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
      "ops": ["esearch.fcgi", "efetch.fcgi"],
      "fields": ["metadata", "abstract"],
      "rate_limit": "1 req/s（匿名模式；不带 API key、不带 email，仅带 tool 名）",
      "priority": 1,
      "crawl_allowed": true
    },
    {
      "id": "crossref",
      "label": "Crossref REST API",
      "access": "api",
      "mode": "anonymous",
      "endpoint": "https://api.crossref.org/works",
      "fields": ["metadata", "abstract(可选)"],
      "rate_limit": "1 req/s（匿名模式：不发送 mailto，不进入 polite pool）",
      "priority": 2,
      "crawl_allowed": true
    },
    {
      "id": "openalex",
      "label": "OpenAlex",
      "access": "api",
      "mode": "anonymous",
      "endpoint": "https://api.openalex.org/works",
      "fields": ["metadata", "abstract_inverted_index（需还原）"],
      "rate_limit": "1 req/s（匿名模式：不发送 mailto，不进入 polite pool）；100k/日",
      "priority": 3,
      "crawl_allowed": true
    },
    {
      "id": "who",
      "label": "WHO 官方指南",
      "access": "web-read",
      "mode": "anonymous",
      "endpoint": "https://www.who.int/publications",
      "fields": ["metadata", "key messages"],
      "rate_limit": "1 req/s",
      "priority": 1,
      "crawl_allowed": true
    },
    {
      "id": "cdc",
      "label": "CDC 身体活动与工作场所健康",
      "access": "web-read",
      "mode": "anonymous",
      "endpoint": "https://www.cdc.gov/physical-activity/",
      "fields": ["metadata", "key recommendations"],
      "rate_limit": "1 req/s",
      "priority": 2,
      "crawl_allowed": true
    },
    {
      "id": "niosh",
      "label": "NIOSH 工效学",
      "access": "web-read",
      "mode": "anonymous",
      "endpoint": "https://www.cdc.gov/niosh/topics/ergonomics/",
      "fields": ["metadata", "key recommendations"],
      "rate_limit": "1 req/s",
      "priority": 2,
      "crawl_allowed": true
    },
    {
      "id": "nhc",
      "label": "国家卫生健康委官网",
      "access": "manual-export",
      "mode": "anonymous",
      "endpoint": "http://www.nhc.gov.cn/",
      "fields": ["metadata", "guideline text"],
      "rate_limit": "不采集",
      "priority": 1,
      "crawl_allowed": false,
      "note": "无公开 API；只允许人工导出后在 notes 标注来源页，不写爬虫"
    },
    {
      "id": "cnki-wanfang",
      "label": "知网 / 万方",
      "access": "manual-export",
      "mode": "anonymous",
      "endpoint": "无公开 API",
      "fields": ["metadata"],
      "rate_limit": "不采集",
      "priority": 3,
      "crawl_allowed": false,
      "note": "仅允许标记“需人工导出”，禁止爬取"
    }
  ],
  "topics": [
    { "id": "sedentary-threshold", "name": "久坐阈值与打断频率", "target": 6, "modules": ["sitting-trigger"] },
    { "id": "micro-break-workplace", "name": "微休息与工作场所干预", "target": 7, "modules": ["intervention-engine", "action-library"] },
    { "id": "neck-shoulder", "name": "颈肩不适", "target": 7, "modules": ["posture-assessment", "action-library"] },
    { "id": "low-back", "name": "腰背不适", "target": 6, "modules": ["posture-assessment", "action-library"] },
    { "id": "safety-redflag", "name": "安全红线与就医边界", "target": 6, "modules": ["safety-check"] },
    { "id": "bct", "name": "行为改变技术（BCT）", "target": 7, "modules": ["weekly-review", "intervention-engine", "qa-responder"] }
  ],
  "roles": [
    {
      "id": "orchestrator",
      "name": "总控 Agent",
      "scope": "拆任务、派活、验收交接物、合并结果、打回重做",
      "out_of_scope": "不直接采集、不直接撰写条目",
      "outputs": ["立项卡", "派工单", "验收结论"]
    },
    {
      "id": "planner",
      "name": "检索计划",
      "scope": "检索式、来源清单、纳入/排除标准",
      "out_of_scope": "不执行检索",
      "outputs": ["检索计划"]
    },
    {
      "id": "harvester",
      "name": "采集",
      "scope": "按来源调用 API 取元数据与摘要，保留原始 JSON 片段",
      "out_of_scope": "不翻译、不提结论、不改字段",
      "outputs": ["raw_records"]
    },
    {
      "id": "extractor",
      "name": "抽取",
      "scope": "字段映射、摘要摘录",
      "out_of_scope": "不判断证据等级、不合并、不新增信息",
      "outputs": ["标准条目"]
    },
    {
      "id": "verifier",
      "name": "核验",
      "scope": "题录核验、等级审计，给出 pass / fail / unknown 与原因",
      "out_of_scope": "不改数据",
      "outputs": ["verification 结论"]
    },
    {
      "id": "merger",
      "name": "合并",
      "scope": "按 DOI → PMID → 标题相似度三级去重，处理冲突",
      "out_of_scope": "不新增条目",
      "outputs": ["去重后的条目"]
    },
    {
      "id": "curator",
      "name": "入库",
      "scope": "Schema 校验、唯一性校验、落盘、生成 QC 报告",
      "out_of_scope": "不修数据",
      "outputs": ["evidence.json", "qc-report.md"]
    },
    {
      "id": "analyst",
      "name": "覆盖度",
      "scope": "按主题矩阵查缺口、给补检建议",
      "out_of_scope": "不自造文献",
      "outputs": ["缺口清单", "抽检清单"]
    }
  ],
  "phases": [
    {
      "id": "P0",
      "name": "立项",
      "owner": "orchestrator",
      "input": "PRD.md；agent-workflow.md；evidence-map.md",
      "output": ["docs/theory/run-2026-11-07/phase0-brief.md"],
      "gate": null,
      "exit_criteria": "主题矩阵、纳排标准、目标条数、截止时间四项齐全"
    },
    {
      "id": "P1",
      "name": "检索计划",
      "owner": "planner",
      "input": "立项卡；来源清单",
      "output": [
        "docs/theory/run-2026-11-07/phase1-search-plan.md",
        "docs/theory/run-2026-11-07/g1-plan.json",
        "docs/theory/run-2026-11-07/g1-gate-record.md"
      ],
      "gate": "G1",
      "exit_criteria": "每个主题至少 1 条英文 + 1 条中文检索式；每个来源有预计条数；gate_check.py 返回 0"
    },
    {
      "id": "P2",
      "name": "采集",
      "owner": "harvester",
      "input": "G1 通过后的检索式",
      "output": ["raw_records（含 requested_url 与原始片段）"],
      "gate": "G2",
      "exit_criteria": "每条有 id、source_type，且 doi / pmid / url 至少其一"
    },
    {
      "id": "P3",
      "name": "抽取",
      "owner": "extractor",
      "input": "raw_records",
      "output": ["标准条目（符合 evidence.schema.json）"],
      "gate": null,
      "exit_criteria": "key_finding 能在摘要中找到原句依据；摘要不可得则为 null"
    },
    {
      "id": "P4",
      "name": "核验",
      "owner": "verifier",
      "input": "标准条目",
      "output": ["verification 字段", "issues"],
      "gate": "G3",
      "exit_criteria": "verified=true，或 notes 明确说明未核验原因"
    },
    {
      "id": "P5",
      "name": "合并",
      "owner": "merger",
      "input": "已核验条目",
      "output": ["去重后的条目", "冲突记录"],
      "gate": null,
      "exit_criteria": "重复判定写出依据；DOI 冲突以 verifier 通过者为准"
    },
    {
      "id": "P6",
      "name": "入库",
      "owner": "curator",
      "input": "去重后的条目",
      "output": ["data/knowledge/evidence.json", "data/knowledge/qc-report.md", "docs/theory/evidence-map.md（回填）"],
      "gate": "G4",
      "exit_criteria": "python scripts/validate_evidence.py 返回 0 error；DOI/PMID 无重复"
    },
    {
      "id": "P7",
      "name": "覆盖度",
      "owner": "analyst",
      "input": "evidence.json",
      "output": ["缺口清单", "补检建议", "10% 抽检清单"],
      "gate": "G5",
      "exit_criteria": "每主题 ≥2 条、指南 ≥3 条、人工抽检 10% 完成"
    }
  ],
  "gates": [
    { "id": "G1", "at": "P1→P2", "pass": "人工确认检索式与来源；g1-plan.json 六主题/来源/邮箱/签字齐备，python scripts/literature/gate_check.py 返回 0", "fail": "退回 planner 改检索式", "blocking": true },
    { "id": "G2", "at": "P2", "pass": "每条有 id、source_type、doi/pmid/url 之一", "fail": "退回 harvester 补采", "blocking": true },
    { "id": "G3", "at": "P4→P5", "pass": "verified=true 或 notes 说明原因", "fail": "退回 verifier 重核", "blocking": true },
    { "id": "G4", "at": "P6", "pass": "Schema 0 error、DOI/PMID 唯一", "fail": "退回 extractor 修字段", "blocking": true },
    { "id": "G5", "at": "P7", "pass": "主题覆盖达标、10% 人工抽检", "fail": "退回 analyst 补检", "blocking": true }
  ],
  "handoff_envelope": {
    "required": ["agent", "task_id", "status", "records", "issues", "next_actions"],
    "status_enum": ["ok", "partial", "blocked"],
    "rules": [
      "status=blocked 必须写清阻塞原因与已尝试次数",
      "records 为空时也要返回该字段",
      "issues 的 type 用下划线短语，例如 auth_required / doi_unresolved / source_rate_limited"
    ]
  },
  "tooling": [
    {
      "gate": "G1",
      "script": "scripts/literature/gate_check.py",
      "input": "docs/theory/run-2026-11-07/g1-plan.json",
      "usage": "python scripts/literature/gate_check.py（0=放行；签字用 --sign --by --email）",
      "enforcement": "Phase 2 采集脚本必须先跑本检查，返回非 0 即拒绝联网"
    },
    {
      "gate": "G4",
      "script": "scripts/validate_evidence.py",
      "input": "data/knowledge/evidence.json + data/knowledge/evidence.schema.json",
      "usage": "python scripts/validate_evidence.py（0=可入库）",
      "enforcement": "非 0 时 curator 不得写 evidence.json"
    }
  ],
  "run_params": {
    "api_mode": "anonymous",
    "contact": null,
    "parallel_subtasks_max": 3,
    "batch_size": 20,
    "rate_limit_per_second": 1,
    "request_interval_sec_min": 1,
    "user_agent": "RiseLoop-lit-ledger/1.0",
    "retry": { "max_attempts": 2, "backoff_sec": [2, 5] },
    "target_records": "40±10（超过 60 条先停下做质量复核）",
    "max_runtime_hours": 2,
    "date_window": "2010-01-01 至今；指南不限发表年但须为现行版本",
    "dedupe_order": ["doi", "pmid", "title_similarity"]
  },
  "stop_conditions": [
    "同一来源连续 3 次失败：停止该来源，记录 issues，继续其他来源",
    "匿名模式下连续两次 403/429：立即暂停全部采集，写入 QC 报告，要求提供项目邮箱后按 identified 模式重试",
    "遇到登录、付费墙、验证码：立即跳过，不尝试任何绕过",
    "摘要不可得：保留元数据，key_finding=null，notes 写“摘要不可得”",
    "主题缺口无法用现有来源补齐：交 analyst 出补检建议，禁止自行编造",
    "单次运行超过 2 小时：未完成批次写入 QC 报告，不带病交付"
  ],
  "forbidden": [
    "抓取全文或绕过付费墙、登录、验证码",
    "爬取知网、万方等无公开 API 的中文库",
    "编造 DOI、PMID、作者、年份、期刊、卷期、页码",
    "把“相关”改写为“导致”，或补摘要没有的剂量、机制、人群",
    "把本工作流接入 services/agent-orchestrator 或产品运行时",
    "以本工作流的角色冒充产品双 Agent，或新增 MCP 工具"
  ]
}
