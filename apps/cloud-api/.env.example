RISELOOP_ENV=local
RISELOOP_CLOUD_PROVIDER=mock
RISELOOP_CORS_ORIGINS=["http://localhost:1420","http://tauri.localhost","tauri://localhost"]

# prod 必须注入随机值；默认值和 change-me-in-huawei-kms 会被拒绝启动
RISELOOP_JWT_SECRET=
RISELOOP_JWT_TTL_SECONDS=3600
RISELOOP_SITTING_THRESHOLD_MINUTES=45
RISELOOP_PUSH_COOLDOWN_MINUTES=10

RISELOOP_RDS_DSN=
RISELOOP_RDS_HOST=127.0.0.1
RISELOOP_RDS_PORT=5432
RISELOOP_RDS_DB=riseloop
RISELOOP_RDS_USER=riseloop
RISELOOP_RDS_PASSWORD=
RISELOOP_RDS_POOL_SIZE=5

RISELOOP_REDIS_URL=
RISELOOP_REDIS_HOST=127.0.0.1
RISELOOP_REDIS_PORT=6379
RISELOOP_REDIS_DB=0
RISELOOP_REDIS_PASSWORD=

RISELOOP_CODEARTS_ENDPOINT=
RISELOOP_CODEARTS_API_KEY=
RISELOOP_CODEARTS_PLANNING_AGENT_ID=
RISELOOP_CODEARTS_EXECUTING_AGENT_ID=
RISELOOP_CODEARTS_TIMEOUT_SECONDS=10

# 密钥不要写进本文件或仓库；本地 mock 留空，云端由环境变量/密钥管理注入。
# OBS 优先使用 IAM 临时凭证：AK + SK + SECURITY_TOKEN；静态密钥只设 AK/SK。
RISELOOP_OBS_ENDPOINT=
RISELOOP_OBS_BUCKET=
RISELOOP_OBS_REGION=
RISELOOP_OBS_AK=
RISELOOP_OBS_SK=
RISELOOP_OBS_SECURITY_TOKEN=

RISELOOP_KMS_ENDPOINT=
RISELOOP_KMS_KEY_ID=
RISELOOP_KMS_MASTER_KEY=

# ModelArts 在线推理：mock 模式留空；huawei 模式填真实 endpoint
RISELOOP_MODELARTS_ENDPOINT=
RISELOOP_MODELARTS_API_KEY=
RISELOOP_MODELARTS_PROJECT_ID=
RISELOOP_MODELARTS_MODEL_NAME=riseloop-posture-v3
RISELOOP_MODELARTS_AUTH_HEADER=x-auth-token  # x-auth-token / authorization / x-api-key / x-apig-appcode
RISELOOP_MODELARTS_TIMEOUT_SECONDS=2.5
# 仅当推理 endpoint 使用自签证书时设为 false；生产应保持 true
RISELOOP_MODELARTS_TLS_VERIFY=true
# mock 只用于联调；演示前设为 unavailable，/posture/infer 会明确 503 降级
RISELOOP_POSTURE_MOCK_POLICY=heuristic

# 问答生成：MaaS 盘古预置模型（可选；不配则回答知识库原文）
# 服务开通在西南-贵阳一，北京四后端跨区调用；密钥只放服务端，不进客户端、日志或镜像
RISELOOP_MAAS_ENDPOINT=
RISELOOP_MAAS_API_KEY=
RISELOOP_MAAS_MODEL=openpangu-2.0-flash
RISELOOP_MAAS_TIMEOUT_SECONDS=15
# 预览版默认带思考链（约 10s / 800+ tokens）；关掉后约 1.5s / 240 tokens
RISELOOP_MAAS_ENABLE_THINKING=false