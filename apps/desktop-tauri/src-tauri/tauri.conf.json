{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SitLoop",
  "version": "0.1.0",
  "identifier": "com.sitloop.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SitLoop",
        "width": 800,
        "height": 820,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/appIcon.ico"
    ]
  }
}
