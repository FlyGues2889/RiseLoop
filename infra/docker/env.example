# 复制为 infra/docker/.env 后改必改项。该文件已被 .gitignore 忽略。
RISELOOP_ENV=prod
RISELOOP_CLOUD_PROVIDER=mock

# 必填：JWT 签名密钥（openssl rand -hex 32）；不要写进仓库，prod 会拒绝空值/模板值
RISELOOP_JWT_SECRET=
# 必改：仅场景 B 的容器内 PostgreSQL 使用；用托管 RDS 时不会被读取
POSTGRES_PASSWORD=change-me-too

# ---- 场景 A：全托管（DCS + 托管 RDS，填内网地址）----
# cloud_provider=huawei 时 RDS DSN 是硬前置：缺失则启动失败，不退回内存存储。
# RISELOOP_CLOUD_PROVIDER=huawei
# RISELOOP_RDS_DSN=postgresql+asyncpg://<用户>:<口令>@<RDS内网地址>:5432/riseloop
# RISELOOP_REDIS_URL=redis://:<DCS口令>@<DCS内网地址>:6379/0

# ---- 场景 B：容器内 PG + Redis（compose 服务名；仅本地冒烟，不算上云）----
# RISELOOP_CLOUD_PROVIDER=mock
# RISELOOP_RDS_DSN=postgresql+asyncpg://riseloop:change-me-too@postgres:5432/riseloop
# RISELOOP_REDIS_URL=redis://redis:6379/0

# ---- 混搭：DCS + 容器内 PG ----
# RISELOOP_CLOUD_PROVIDER=huawei
# RISELOOP_RDS_DSN=postgresql+asyncpg://riseloop:change-me-too@postgres:5432/riseloop
# RISELOOP_REDIS_URL=redis://:<DCS口令>@<DCS内网地址>:6379/0

# 以下默认值可直接用，需要时再放开
# RISELOOP_SITTING_THRESHOLD_MINUTES=45
# RISELOOP_PUSH_COOLDOWN_MINUTES=10
